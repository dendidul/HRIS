@model HRIS.General.Model.Tax.TaxServiceOfficeModel

@{
    ViewData["Title"] = "Tax Office Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Tax Service Office Details</h5>
        <small class="text-muted float-end">Tax Management</small>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Office Code</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.tax_office_code)</dd>

            <dt class="col-sm-3">Short Description</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.short_desc)</dd>

            <dt class="col-sm-3">Long Description</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.long_desc)</dd>
        </dl>

        <div class="mt-4 d-flex gap-2">
            <a href="@Url.Action("Edit", "TaxOfficer", new { id = Model.id })" class="btn btn-primary">
                <i class="bx bx-edit me-1"></i> Edit
            </a>
            <a href="@Url.Action("Index", "TaxOfficer")" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>
</div>
