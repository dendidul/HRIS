@model HRIS.General.Model.Master.PositionModel


@{
    ViewData["Title"] = "Create Position";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Create", "Position", FormMethod.Post, new { Id = "formCreateArea" }))
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            
            <h4 class="card-title mb-0">Create</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-6">
                    <label>Area Code</label>
                    @Html.TextBoxFor(model => model.position_id, new { Class = "form-control", required = "true" })
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label>Short Desc</label>
                        @Html.TextBoxFor(model => model.short_description, new { Class = "form-control", required = "true" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-6">
                    <label>Long Desc</label>
                    @Html.TextAreaFor(model => model.long_description, new { Class = "form-control" })
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-6">
                    <button type="submit" class="btn btn-success">Save</button>
                    <a href="@Url.Action("Index","Position")" class="btn btn-warning">Cancel</a>
                </div>
            </div>





        </div>
    </div>
}



@section scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            App.init();
        });
    </script>
}



