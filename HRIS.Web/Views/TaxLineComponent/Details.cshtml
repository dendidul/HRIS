@model HRIS.General.Model.Tax.TaxLineComponent

@{
    ViewData["Title"] = "Tax Line Component Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Tax Line Component Details</h5>
        <small class="text-muted float-end">Tax Management</small>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Tax Line Code</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.tax_line)</dd>

            <dt class="col-sm-3">Payroll Component ID</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.payroll_component_id)</dd>

            <dt class="col-sm-3">Created By</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.created_by)</dd>

            <dt class="col-sm-3">Created Date</dt>
            <dd class="col-sm-9">@(Model.created_date?.ToString("dd MMM yyyy HH:mm") ?? "-")</dd>
        </dl>

        <div class="mt-4 d-flex gap-2">
            <a href="@Url.Action("Edit", "TaxLineComponent", new { id = Model.id })" class="btn btn-primary">
                <i class="bx bx-edit me-1"></i> Edit
            </a>
            <a href="@Url.Action("Index", "TaxLineComponent")" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>
</div>
