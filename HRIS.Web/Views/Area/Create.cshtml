@model HRIS.General.Model.Master.AreaModel

@{
    ViewData["Title"] = "Create Area";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Create", "Area", FormMethod.Post, new { Id = "formCreateArea" }))
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Create Area</h5>
            <small class="text-muted float-end">Master Data</small>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="area_code">Area Code</label>
                    @Html.TextBoxFor(model => model.area_code, new { Class = "form-control", id = "area_code", required = "true", placeholder = "Enter Area Code" })
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="short_desc">Short Desc</label>
                    @Html.TextBoxFor(model => model.short_desc, new { Class = "form-control", id = "short_desc", required = "true", placeholder = "Enter Short Description" })
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-12">
                    <label class="form-label" for="long_desc">Long Desc</label>
                    @Html.TextAreaFor(model => model.long_desc, new { Class = "form-control", id = "long_desc", rows = "3", placeholder = "Enter Long Description" })
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bx bx-save me-1"></i> Save
                </button>
                <a href="@Url.Action("Index", "Area")" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </div>
}

@section scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            // Document ready initialization
        });
    </script>
}
