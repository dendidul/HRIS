@model HRIS.General.Model.Tax.TaxParameterModel

@{
    ViewData["Title"] = "Edit Tax Parameter";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Edit", "TaxParameter", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.id)
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Edit Tax Parameter</h5>
            <small class="text-muted float-end">Tax Management</small>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label" for="tax_parameter_id">Parameter Code</label>
                    @Html.TextBoxFor(model => model.tax_parameter_id, new { Class = "form-control", id = "tax_parameter_id", required = "true" })
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="short_desc">Short Description</label>
                    @Html.TextBoxFor(model => model.short_desc, new { Class = "form-control", id = "short_desc", required = "true" })
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="long_desc">Long Description</label>
                    @Html.TextBoxFor(model => model.long_desc, new { Class = "form-control", id = "long_desc" })
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="max_position_tax">Max Position Cost (Biaya Jabatan)</label>
                    @Html.TextBoxFor(model => model.max_position_tax, new { Class = "form-control", id = "max_position_tax" })
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="position_tax_percentage">Position Tax Percentage (%)</label>
                    @Html.TextBoxFor(model => model.position_tax_percentage, new { Class = "form-control", id = "position_tax_percentage" })
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="form-label" for="begin_date">Begin Date</label>
                    @Html.TextBoxFor(model => model.begin_date, "{0:yyyy-MM-dd}", new { Class = "form-control", id = "begin_date", type = "date" })
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="end_date">End Date</label>
                    @Html.TextBoxFor(model => model.end_date, "{0:yyyy-MM-dd}", new { Class = "form-control", id = "end_date", type = "date" })
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bx bx-save me-1"></i> Update
                </button>
                <a href="@Url.Action("Index", "TaxParameter")" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </div>
}
