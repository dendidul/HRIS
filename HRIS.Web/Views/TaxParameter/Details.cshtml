@model HRIS.General.Model.Tax.TaxParameterModel

@{
    ViewData["Title"] = "Tax Parameter Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Tax Parameter Details</h5>
        <small class="text-muted float-end">Tax Management</small>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Parameter Code</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.tax_parameter_id)</dd>

            <dt class="col-sm-3">Short Description</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.short_desc)</dd>

            <dt class="col-sm-3">Long Description</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.long_desc)</dd>

            <dt class="col-sm-3">Max Position Tax</dt>
            <dd class="col-sm-9">@(Model.max_position_tax?.ToString("N0") ?? "0")</dd>

            <dt class="col-sm-3">Position Tax %</dt>
            <dd class="col-sm-9">@(Model.position_tax_percentage ?? 0)%</dd>

            <dt class="col-sm-3">Begin Date</dt>
            <dd class="col-sm-9">@(Model.begin_date?.ToString("dd MMM yyyy") ?? "-")</dd>

            <dt class="col-sm-3">End Date</dt>
            <dd class="col-sm-9">@(Model.end_date?.ToString("dd MMM yyyy") ?? "-")</dd>
        </dl>

        <div class="mt-4 d-flex gap-2">
            <a href="@Url.Action("Edit", "TaxParameter", new { id = Model.id })" class="btn btn-primary">
                <i class="bx bx-edit me-1"></i> Edit
            </a>
            <a href="@Url.Action("Index", "TaxParameter")" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>
</div>
