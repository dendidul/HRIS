@model HRIS.General.Model.Master.ObjectMasterModel


@{
    ViewData["Title"] = "Create Object Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Create", "ObjectMaster", FormMethod.Post, new { Id = "formCreateObjectMaster" }))
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            
            <h4 class="card-title mb-0">Create</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-6">
                    <label>Object Type</label>
                    @Html.TextBoxFor(model => model.object_type, new { Class = "form-control", required = "true" })
                </div>
                <div class="col-6">
                    <label>Format Number</label>
                    @Html.TextBoxFor(model => model.format_number, new { Class = "form-control", required = "true" })
                </div>
                <div class="col-6">
                    <label>Last Number </label>
                    @Html.TextBoxFor(model => model.last_number, new { Class = "form-control", required = "true" })
                </div>
             
            </div>

            <br />
            <div class="row">
                <div class="col-6">
                    <button type="submit" class="btn btn-success">Save</button>
                    <a href="@Url.Action("Index","ObjectMaster")" class="btn btn-warning">Cancel</a>
                </div>
            </div>





        </div>
    </div>
}



@section scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            App.init();
        });
    </script>
}



