@model IEnumerable<HRIS.General.Model.Master.ObjectMasterModel>

@{
    ViewData["Title"] = "List Object Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        
        <h4 class="card-title mb-0">Object Master</h4>
    </div>
    <div class="card-body">
        <p>
            <a class="btn btn-primary" asp-action="Create">Create New</a>
        </p>
        <table class="table table-striped table-bordered" id="data-table-responsive" style="width:100%">
            <thead>
                <tr>

                    <th>
                        Object Type
                    </th>
                    <th>
                       Format Number
                    </th>
                    <th>
                        Last Number
                    </th>

                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @Html.DisplayFor(modelItem => item.object_type)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.format_number)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.last_number)
                        </td>


                        <td>
                            @Html.ActionLink("Edit", "Edit", "ObjectMaster", new { id = item.id }, new { @class = "btn btn-success m-b-5" })
                            @Html.ActionLink("Details", "Details", "ObjectMaster", new { id = item.id }, new { @class = "btn btn-warning m-b-5" })
                            @Html.ActionLink("Delete", "Delete", new { id = item.id }, new { @class = "btn btn-danger m-b-5" })

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            App.init();
            TableManageResponsive.init();
        });
    </script>
}
