@model IEnumerable<HRIS.General.Model.UserManagement.RolesModel>

@{
    ViewData["Title"] = "List Access Module";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        
        <h4 class="card-title mb-0">Access Module</h4>
    </div>
    <div class="card-body">
       
        <table class="table table-striped table-bordered" id="data-table-responsive" style="width:100%">
            <thead>
                <tr>

                    <th>
                        Roles Code
                    </th>
                    <th>
                        Description
                    </th>
                  




                    <th class="text-center" style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @Html.DisplayFor(modelItem => item.role_id)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.role_desc)
                        </td>
                      
                        <td>
                            @Html.ActionLink("Config", "Config", "AccessModule", new { id = item.id }, new { @class = "btn btn-sm btn-outline-primary me-1" })
                         
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@section scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            App.init();
            TableManageResponsive.init();
        });
    </script>
}
