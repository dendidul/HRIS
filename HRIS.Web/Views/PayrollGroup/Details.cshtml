@model HRIS.General.Model.Payroll.PayGroupModel

@{
    ViewData["Title"] = "Payroll Group Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Payroll Group Details</h5>
        <small class="text-muted float-end">Payroll Management</small>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Group Code</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.pgrid)</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.sdesc)</dd>

            <dt class="col-sm-3">Period ID</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.payroll_periode_id)</dd>

            <dt class="col-sm-3">Begin Date</dt>
            <dd class="col-sm-9">@(Model.begdt?.ToString("dd MMM yyyy") ?? "-")</dd>

            <dt class="col-sm-3">End Date</dt>
            <dd class="col-sm-9">@(Model.enddt?.ToString("dd MMM yyyy") ?? "-")</dd>

            <dt class="col-sm-3">Created By</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.created_by)</dd>
        </dl>

        <div class="mt-4 d-flex gap-2">
            <a href="@Url.Action("Edit", "PayrollGroup", new { id = Model.id })" class="btn btn-primary">
                <i class="bx bx-edit me-1"></i> Edit
            </a>
            <a href="@Url.Action("Index", "PayrollGroup")" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>
</div>
