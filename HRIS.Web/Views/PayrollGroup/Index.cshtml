@model IEnumerable<HRIS.General.Model.Payroll.PayGroupModel>

@{
    ViewData["Title"] = "Payroll Group";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Payroll Group</h5>
        <a class="btn btn-primary" asp-action="Create">
            <i class="bx bx-plus me-1"></i> Create New
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive text-nowrap">
            <table class="table table-hover table-striped" id="data-table-responsive" style="width:100%">
                <thead>
                    <tr>
                        <th>Group ID</th>
                        <th>Description</th>
                        <th>Period ID</th>
                        <th>Begin Date</th>
                        <th>End Date</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                    @if (Model != null)
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.pgrid</strong></td>
                                <td>@item.sdesc</td>
                                <td>@item.payroll_periode_id</td>
                                <td>@(item.begdt?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>@(item.enddt?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="text-center">
                                    <a class="btn btn-sm btn-outline-primary me-1" asp-action="Edit" asp-route-id="@item.id">Edit</a>
                                    <a class="btn btn-sm btn-outline-info me-1" asp-action="Details" asp-route-id="@item.id">Details</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.id">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            if (typeof TableManageResponsive !== 'undefined') {
                TableManageResponsive.init();
            }
        });
    </script>
}
