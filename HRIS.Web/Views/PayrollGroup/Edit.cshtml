@model HRIS.General.Model.Payroll.PayGroupModel

@{
    ViewData["Title"] = "Edit Payroll Group";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var periods = ViewBag.Periods as IEnumerable<HRIS.General.Model.Payroll.PayPeriodModel> ?? new List<HRIS.General.Model.Payroll.PayPeriodModel>();
}

@using (Html.BeginForm("Edit", "PayrollGroup", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.id)
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Edit Payroll Group</h5>
            <small class="text-muted float-end">Payroll Management</small>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label" for="pgrid">Payroll Group Code</label>
                    @Html.TextBoxFor(model => model.pgrid, new { Class = "form-control", id = "pgrid", required = "true" })
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="sdesc">Description</label>
                    @Html.TextBoxFor(model => model.sdesc, new { Class = "form-control", id = "sdesc", required = "true" })
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="payroll_periode_id">Payroll Period</label>
                    <select name="payroll_periode_id" class="form-select">
                        <option value="">-- Select Period --</option>
                        @foreach (var p in periods)
                        {
                            <option value="@p.id" selected="@(Model.payroll_periode_id == p.id)">@p.payroll_periode_id - @p.short_desc</option>
                        }
                    </select>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="form-label" for="begdt">Begin Date</label>
                    @Html.TextBoxFor(model => model.begdt, "{0:yyyy-MM-dd}", new { Class = "form-control", id = "begdt", type = "date" })
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="enddt">End Date</label>
                    @Html.TextBoxFor(model => model.enddt, "{0:yyyy-MM-dd}", new { Class = "form-control", id = "enddt", type = "date" })
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bx bx-save me-1"></i> Update
                </button>
                <a href="@Url.Action("Index", "PayrollGroup")" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </div>
}
