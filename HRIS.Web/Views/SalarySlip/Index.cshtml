@model IEnumerable<HRIS.General.Model.Payroll.PayCalculationModel>

@{
    ViewData["Title"] = "Salary Slip";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var employees = ViewBag.Employees as IEnumerable<HRIS.General.Model.PersonalAdmin.PeopleModel> ?? new List<HRIS.General.Model.PersonalAdmin.PeopleModel>();
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Salary Slips / Slip Gaji</h5>
        <small class="text-muted">Generated from completed payroll batches</small>
    </div>
    <div class="card-body">
        <div class="table-responsive text-nowrap">
            <table class="table table-hover table-striped" id="data-table-responsive" style="width:100%">
                <thead>
                    <tr>
                        <th>Batch #</th>
                        <th>Year Period</th>
                        <th>Begin Date</th>
                        <th>End Date</th>
                        <th>Processed Employees</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                    @if (Model != null)
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>#@item.id</strong></td>
                                <td>@item.year_period</td>
                                <td>@(item.begin_date?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>@(item.end_date?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>@(item.processed_employee ?? 0)</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseBatch@(item.id)">
                                        <i class="bx bx-show me-1"></i> View Employees
                                    </button>
                                </td>
                            </tr>
                            <tr class="collapse" id="collapseBatch@(item.id)">
                                <td colspan="6" class="p-3 bg-light">
                                    <div class="card shadow-none border">
                                        <div class="card-body p-3">
                                            <h6 class="card-title mb-2">Select Employee to View / Print Payslip:</h6>
                                            <div class="row g-2">
                                                @foreach (var emp in employees.Take(15))
                                                {
                                                    <div class="col-md-4">
                                                        <a href="@Url.Action("ViewSlip", "SalarySlip", new { calculationId = item.id, employeeId = emp.id })" class="btn btn-outline-secondary btn-sm w-100 text-start">
                                                            <i class="bx bx-user me-1"></i> @emp.nik - @emp.first_name @emp.last_name
                                                        </a>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            if (typeof TableManageResponsive !== 'undefined') {
                TableManageResponsive.init();
            }
        });
    </script>
}
