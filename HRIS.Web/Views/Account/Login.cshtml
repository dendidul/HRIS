@model HRIS.General.Model.UserManagement.UserModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en"
      class="light-style layout-wide customizer-hide"
      dir="ltr"
      data-theme="theme-default"
      data-assets-path="~/sneat/"
      data-template="vertical-menu-template-free">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>HRIS | Login</title>
    <meta name="description" content="Human Resource Information System Login" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/sneat/img/favicon/favicon.ico" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet" />

    <!-- Icons -->
    <link rel="stylesheet" href="~/sneat/vendor/fonts/boxicons.css" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="~/sneat/vendor/css/core.css" class="template-customizer-core-css" />
    <link rel="stylesheet" href="~/sneat/vendor/css/theme-default.css" class="template-customizer-theme-css" />
    <link rel="stylesheet" href="~/sneat/css/demo.css" />

    <!-- Page CSS -->
    <link rel="stylesheet" href="~/sneat/vendor/css/pages/page-auth.css" />
    <link rel="stylesheet" href="~/assets/plugins/gritter/css/jquery.gritter.css" />

    <!-- Helpers -->
    <script src="~/sneat/vendor/js/helpers.js"></script>
    <script src="~/sneat/js/config.js"></script>
</head>

<body>
    <!-- Content -->
    <div class="container-xxl">
        <div class="authentication-wrapper authentication-basic container-p-y">
            <div class="authentication-inner">
                <!-- Register -->
                <div class="card">
                    <div class="card-body">
                        <!-- Logo -->
                        <div class="app-brand justify-content-center mb-4">
                            <a href="#" class="app-brand-link gap-2">
                                <span class="app-brand-logo demo">
                                    <i class="bx bx-buildings text-primary fs-2"></i>
                                </span>
                                <span class="app-brand-text demo text-body fw-bold text-capitalize fs-3">HRIS</span>
                            </a>
                        </div>
                        <!-- /Logo -->
                        <h4 class="mb-2 text-center">Welcome to HRIS! 👋</h4>
                        <p class="mb-4 text-center">Please sign-in to your account to continue</p>

                        @using (Html.BeginForm(null, null, FormMethod.Post, new { Class = "mb-3", Id = "frm_Login" }))
                        {
                            <div class="mb-3">
                                <label for="username" class="form-label">Username</label>
                                @Html.TextBoxFor(model => model.username, new { Class = "form-control", id = "username", required = "true", placeholder = "Enter your username", autofocus = "autofocus" })
                            </div>
                            <div class="mb-3 form-password-toggle">
                                <div class="d-flex justify-content-between">
                                    <label class="form-label" for="password">Password</label>
                                </div>
                                <div class="input-group input-group-merge">
                                    @Html.PasswordFor(model => model.password, new { Class = "form-control", id = "password", required = "true", placeholder = "············" })
                                    <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <button class="btn btn-primary d-grid w-100" type="submit" id="btn_signin">Sign in</button>
                            </div>
                        }

                        <p class="text-center text-muted small mt-4 mb-0">
                            &copy; @DateTime.Now.Year HRIS. All Rights Reserved.
                        </p>
                    </div>
                </div>
                <!-- /Register -->
            </div>
        </div>
    </div>
    <!-- / Content -->

    <!-- Core JS -->
    <script src="~/sneat/vendor/libs/jquery/jquery.js"></script>
    <script src="~/sneat/vendor/libs/popper/popper.js"></script>
    <script src="~/sneat/vendor/js/bootstrap.js"></script>
    <script src="~/sneat/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/sneat/vendor/js/menu.js"></script>
    <script src="~/assets/plugins/gritter/js/jquery.gritter.js"></script>
    <script src="~/sneat/js/main.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#frm_Login').submit(function (e) {
                e.preventDefault();
                var url = '@Url.Action("Login", "Account")';

                $.ajax({
                    url: url,
                    type: "POST",
                    data: $('#frm_Login').serialize(),
                    success: function (data) {
                        if (data.user == "Valid") {
                            $.gritter.add({
                                title: 'Success!',
                                text: 'Login berhasil! Mengalihkan...'
                            });

                            setTimeout(function () {
                                if (data.roleId == 1) {
                                    window.location.href = "@Url.Action("Dashboard", "Home")";
                                } else {
                                    window.location.href = "@Url.Action("Index", "Home")";
                                }
                            }, 500);
                        } else if (data.user == "NotValid") {
                            $.gritter.add({
                                title: 'Login Gagal!',
                                text: 'Username atau password tidak valid!'
                            });
                        }
                    },
                    error: function (data) {
                        $.gritter.add({
                            title: 'Error!',
                            text: 'Terjadi kesalahan sistem saat menghubungi server.'
                        });
                    }
                });
            });
        });
    </script>
</body>
</html>
