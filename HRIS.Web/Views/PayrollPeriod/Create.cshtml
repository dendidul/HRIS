@model HRIS.General.Model.Payroll.PayPeriodModel

@{
    ViewData["Title"] = "Create Payroll Period";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Create", "PayrollPeriod", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Create Payroll Period</h5>
            <small class="text-muted float-end">Payroll Management</small>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label" for="payroll_periode_id">Period Code</label>
                    @Html.TextBoxFor(model => model.payroll_periode_id, new { Class = "form-control", id = "payroll_periode_id", required = "true", placeholder = "e.g. M01" })
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="short_desc">Short Description</label>
                    @Html.TextBoxFor(model => model.short_desc, new { Class = "form-control", id = "short_desc", required = "true" })
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="long_desc">Long Description</label>
                    @Html.TextBoxFor(model => model.long_desc, new { Class = "form-control", id = "long_desc" })
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="form-label" for="begin_date">Begin Date</label>
                    @Html.TextBoxFor(model => model.begin_date, "{0:yyyy-MM-dd}", new { Class = "form-control", id = "begin_date", type = "date" })
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="end_date">End Date</label>
                    @Html.TextBoxFor(model => model.end_date, "{0:yyyy-MM-dd}", new { Class = "form-control", id = "end_date", type = "date" })
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bx bx-save me-1"></i> Save
                </button>
                <a href="@Url.Action("Index", "PayrollPeriod")" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </div>
}
