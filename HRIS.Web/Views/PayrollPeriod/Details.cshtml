@model HRIS.General.Model.Payroll.PayPeriodModel

@{
    ViewData["Title"] = "Payroll Period Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Payroll Period Details</h5>
        <small class="text-muted float-end">Payroll Management</small>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Period Code</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.payroll_periode_id)</dd>

            <dt class="col-sm-3">Short Description</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.short_desc)</dd>

            <dt class="col-sm-3">Long Description</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.long_desc)</dd>

            <dt class="col-sm-3">Begin Date</dt>
            <dd class="col-sm-9">@(Model.begin_date?.ToString("dd MMM yyyy") ?? "-")</dd>

            <dt class="col-sm-3">End Date</dt>
            <dd class="col-sm-9">@(Model.end_date?.ToString("dd MMM yyyy") ?? "-")</dd>

            <dt class="col-sm-3">Created By</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.created_by)</dd>
        </dl>

        <div class="mt-4 d-flex gap-2">
            <a href="@Url.Action("Edit", "PayrollPeriod", new { id = Model.id })" class="btn btn-primary">
                <i class="bx bx-edit me-1"></i> Edit
            </a>
            <a href="@Url.Action("Index", "PayrollPeriod")" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>
</div>
