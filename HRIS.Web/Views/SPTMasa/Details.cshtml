@model HRIS.General.Model.Tax.TaxCalcModel

@{
    ViewData["Title"] = "Tax Calculation Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var employee = ViewBag.Employee as HRIS.General.Model.PersonalAdmin.PeopleModel;
    var officer = ViewBag.Officer as HRIS.General.Model.Tax.TaxServiceOfficeModel;
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">PPh 21 Calculation Details - Sequence #@Model.sequence</h5>
        <small class="text-muted float-end">Statutory PPh 21</small>
    </div>
    <div class="card-body">
        <div class="row border-bottom pb-3 mb-3">
            <div class="col-sm-6">
                <h6><strong>Employee:</strong> @(employee != null ? $"{employee.first_name} {employee.last_name}" : $"ID #{Model.status_employee_id}")</h6>
                <p class="mb-0">NIK: @(employee?.nik ?? "N/A")</p>
            </div>
            <div class="col-sm-6 text-sm-end">
                <h6><strong>Tax Office (KPP):</strong> @(officer?.short_desc ?? "N/A")</h6>
                <p class="mb-0">Tax Year Period: @Model.year_period</p>
            </div>
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-4">Gross Regular Earnings (Penghasilan Bruto)</dt>
            <dd class="col-sm-8 text-success fw-bold">IDR @(Model.regular_gross?.ToString("N0") ?? "0")</dd>

            <dt class="col-sm-4">Biaya Jabatan (Position Cost 5%)</dt>
            <dd class="col-sm-8 text-danger">IDR @(Model.position_cost?.ToString("N0") ?? "0")</dd>

            <dt class="col-sm-4">Net Regular Income (Penghasilan Neto)</dt>
            <dd class="col-sm-8 fw-bold">IDR @(Model.regular_net?.ToString("N0") ?? "0")</dd>

            <dt class="col-sm-4">PTKP (Penghasilan Tidak Kena Pajak)</dt>
            <dd class="col-sm-8">IDR @(Model.ptkp?.ToString("N0") ?? "0")</dd>

            <dt class="col-sm-4">Monthly PPh 21 Tax (Pajak Terutang)</dt>
            <dd class="col-sm-8 text-danger fw-bold fs-5">IDR @(Model.tax_paid?.ToString("N0") ?? "0")</dd>

            <dt class="col-sm-4">Net Income After Tax</dt>
            <dd class="col-sm-8 text-primary fw-bold fs-5">IDR @(Model.payment_regular_net?.ToString("N0") ?? "0")</dd>
        </dl>

        <div class="mt-4 d-flex gap-2">
            <a href="@Url.Action("Index", "SPTMasa")" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>
</div>
