@{
    ViewData["Title"] = "Calculate PPh 21";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var officers = ViewBag.Officers as IEnumerable<HRIS.General.Model.Tax.TaxServiceOfficeModel> ?? new List<HRIS.General.Model.Tax.TaxServiceOfficeModel>();
    var processes = ViewBag.Processes as IEnumerable<HRIS.General.Model.Payroll.PayProcModel> ?? new List<HRIS.General.Model.Payroll.PayProcModel>();
}

@using (Html.BeginForm("Calculate", "SPTMasa", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Run Tax PPh 21 Calculation</h5>
            <small class="text-muted float-end">Statutory PPh 21</small>
        </div>
        <div class="card-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label" for="yearPeriod">Tax Year Period</label>
                    <input type="number" name="yearPeriod" class="form-control" value="@DateTime.Now.Year" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="payrollProcessId">Payroll Process</label>
                    <select name="payrollProcessId" class="form-select" required>
                        <option value="">-- Select Payroll Process --</option>
                        @foreach (var p in processes)
                        {
                            <option value="@p.id">@p.payroll_process_id - @p.short_desc</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="taxServiceOfficeId">Kantor Pelayanan Pajak (KPP)</label>
                    <select name="taxServiceOfficeId" class="form-select" required>
                        <option value="">-- Select KPP --</option>
                        @foreach (var o in officers)
                        {
                            <option value="@o.id">@o.tax_office_code - @o.short_desc</option>
                        }
                    </select>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" onclick="return confirm('Execute PPh 21 calculation for this period?');">
                    <i class="bx bx-calculator me-1"></i> Calculate PPh 21
                </button>
                <a href="@Url.Action("Index", "SPTMasa")" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </div>
}
