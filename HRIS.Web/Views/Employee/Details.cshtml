@model HRIS.General.Model.PersonalAdmin.EmployeeAttributeViewModel

@{
    ViewData["Title"] = "Employee Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var fullName = $"{Model.People?.first_name} {Model.People?.middle_name} {Model.People?.last_name}".Trim();
}

<div class="row">
    <!-- Profile Card Summary -->
    <div class="col-xl-4 col-lg-5 col-md-5">
        <div class="card mb-4">
            <div class="card-body text-center">
                <div class="mx-auto mb-3">
                    @if (!string.IsNullOrEmpty(Model.People?.photo_path))
                    {
                        <img src="@Model.People.photo_path" alt="Avatar" class="rounded-circle" style="width: 120px; height: 120px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="avatar avatar-xl mx-auto">
                            <span class="avatar-initial rounded-circle bg-label-primary fs-2">
                                @(string.IsNullOrEmpty(Model.People?.first_name) ? "E" : Model.People.first_name.Substring(0, 1))
                            </span>
                        </div>
                    }
                </div>
                <h4 class="mb-1">@fullName</h4>
                <span class="badge bg-label-info mb-3">@(Model.EmployeeAttributes?.position_desc ?? "No Position Assigned")</span>

                <div class="d-flex justify-content-center gap-2 mb-3">
                    <span class="badge @(Model.EmployeeAttributes?.status_employee == "AKTIF" ? "bg-label-success" : "bg-label-warning")">
                        @(Model.EmployeeAttributes?.status_employee ?? "UNKNOWN")
                    </span>
                    <span class="badge bg-label-secondary">NIK: @(Model.EmployeeAttributes?.nik ?? "-")</span>
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.People.id" class="btn btn-primary btn-sm">
                        <i class="bx bx-edit-alt me-1"></i> Edit Profile
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bx bx-arrow-back me-1"></i> Back
                    </a>
                </div>
            </div>
            <div class="card-body border-top">
                <small class="text-muted text-uppercase">Details</small>
                <ul class="list-unstyled mb-0 mt-3">
                    <li class="d-flex align-items-center mb-3">
                        <i class="bx bx-envelope me-2"></i>
                        <span>Email: <strong>@(Model.EmployeeAttributes?.email ?? "-")</strong></span>
                    </li>
                    <li class="d-flex align-items-center mb-3">
                        <i class="bx bx-building me-2"></i>
                        <span>Unit: <strong>@(Model.EmployeeAttributes?.unit_desc ?? "-")</strong></span>
                    </li>
                    <li class="d-flex align-items-center mb-3">
                        <i class="bx bx-briefcase me-2"></i>
                        <span>Job: <strong>@(Model.EmployeeAttributes?.job_desc ?? "-")</strong></span>
                    </li>
                    <li class="d-flex align-items-center mb-3">
                        <i class="bx bx-calendar me-2"></i>
                        <span>Hire Date: <strong>@(Model.EmployeeAttributes?.hire_date?.ToString("dd-MM-yyyy") ?? "-")</strong></span>
                    </li>
                    <li class="d-flex align-items-center">
                        <i class="bx bx-time me-2"></i>
                        <span>Shift/Workgroup: <strong>@(Model.WorkgroupName ?? "-")</strong></span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Detailed Tabs -->
    <div class="col-xl-8 col-lg-7 col-md-7">
        <div class="nav-align-top mb-4">
            <ul class="nav nav-tabs" role="tablist">
                <li class="nav-item">
                    <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#tab-personal">
                        Personal Data
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#tab-payroll">
                        Payroll & Tax
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#tab-bank-address">
                        Bank & Address
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#tab-family">
                        Family (@Model.FamilyList.Count)
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- Tab: Personal -->
                <div class="tab-pane fade show active" id="tab-personal" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Gender:</span>
                            <strong>@(Model.People?.gender == "M" ? "Laki-laki (Male)" : (Model.People?.gender == "F" ? "Perempuan (Female)" : "-"))</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Religion:</span>
                            <strong>@(Model.People?.religion ?? "-")</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Birth:</span>
                            <strong>@(Model.People?.birth_place ?? "-"), @(Model.People?.birth_date?.ToString("dd-MM-yyyy") ?? "-")</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Marital Status:</span>
                            <strong>@(Model.People?.marital_status_id ?? "-")</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Education:</span>
                            <strong>@(Model.People?.education ?? "-") - @(Model.People?.institution ?? "-")</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Major:</span>
                            <strong>@(Model.People?.majority ?? "-")</strong>
                        </div>
                    </div>
                </div>

                <!-- Tab: Payroll & Tax -->
                <div class="tab-pane fade" id="tab-payroll" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Payroll Group:</span>
                            <strong>@(Model.EmployeeAttributes?.payroll_group_desc ?? "-")</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Cost Center:</span>
                            <strong>@(Model.EmployeeAttributes?.cost_center_desc ?? "-")</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Bank Source:</span>
                            <strong>@(Model.EmployeeAttributes?.bank_source_desc ?? "-")</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Basic Wage:</span>
                            <strong>@(Model.EmployeeAttributes?.employee_currency ?? "IDR") @(Model.EmployeeAttributes?.employee_basic_wage ?? "0")</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">PTKP / Tax Status:</span>
                            <strong>@(Model.EmpTax?.tax_type ?? "-")</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">KPP (Tax Office):</span>
                            <strong>@(Model.Kpp ?? "-")</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Fingerprint / Machine ID:</span>
                            <strong>@(Model.EmpTime?.finger_id != null ? Model.EmpTime.finger_id.ToString() : "-")</strong>
                        </div>
                    </div>
                </div>

                <!-- Tab: Bank & Address -->
                <div class="tab-pane fade" id="tab-bank-address" role="tabpanel">
                    <h6 class="mb-3">Bank Accounts</h6>
                    @if (Model.BankList != null && Model.BankList.Any())
                    {
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered table-sm">
                                <thead>
                                    <tr>
                                        <th>Bank Name</th>
                                        <th>Account Number</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in Model.BankList)
                                    {
                                        <tr>
                                            <td>@b.bank_name</td>
                                            <td>@b.bank_account</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-4">No bank account recorded.</p>
                    }

                    <h6 class="mb-3">Addresses</h6>
                    @if (Model.AddressList != null && Model.AddressList.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Address</th>
                                        <th>Phone</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in Model.AddressList)
                                    {
                                        <tr>
                                            <td>@a.AddressType</td>
                                            <td>@a.Address</td>
                                            <td>@a.Telp</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No address recorded.</p>
                    }
                </div>

                <!-- Tab: Family -->
                <div class="tab-pane fade" id="tab-family" role="tabpanel">
                    @if (Model.FamilyList != null && Model.FamilyList.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Relation</th>
                                        <th>Birth Date</th>
                                        <th>Education</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fam in Model.FamilyList)
                                    {
                                        <tr>
                                            <td>@fam.name</td>
                                            <td>@fam.relation_type</td>
                                            <td>@(fam.birthdate?.ToString("dd-MM-yyyy") ?? "-")</td>
                                            <td>@fam.education</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No family members recorded.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
