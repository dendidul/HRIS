@model IEnumerable<HRIS.General.Model.PersonalAdmin.PeopleModel>

@{
    ViewData["Title"] = "List Employee";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        
        <h4 class="card-title mb-0">Employee</h4>
    </div>
    <div class="card-body">
        <p>
            <a class="btn btn-primary" asp-action="Create">Create New</a>
        </p>
        <table class="table table-striped table-bordered" id="data-table-responsive" style="width:100%">
            <thead>
                <tr>

                    <th>
                        Employee ID
                    </th>
                    <th>
                        Employee Name
                    </th>
                    <th>
                        Employee Status
                    </th>
                    <th>
                        Begin Date
                    </th>
                    <th>
                        End Date
                    </th>




                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                <tr>

                    <td>
                        @item.nik

                    </td>
                    <td>
                        @{ 
                           var EmployeeName =  item.first_name + " " + item.middle_name + " " + item.last_name;
                            @EmployeeName
                        }

                      
                    </td>
                    <td>
                        @item.status_employee

                    </td>
                    <td>
                        @{
                            if (item.hire_date.HasValue)
                            {
                                @item.hire_date.Value.ToString("dd-MM-yyyy")
                            }

                        }


                    </td>
                    <td>
                        @{
                            if (item.terminate_date.HasValue)
                            {
                                @item.terminate_date.Value.ToString("dd-MM-yyyy")
                            }

                        }

                    </td>

                    <td>
                        @Html.ActionLink("Edit", "Edit", "Employee", new { id = item.id }, new { @class = "btn btn-success m-b-5" })
                        @Html.ActionLink("Details", "Details", "Employee", new { id = item.id }, new { @class = "btn btn-warning m-b-5" })
                        @Html.ActionLink("Delete", "Delete", "Employee", new { id = item.id }, new { @class = "btn btn-danger m-b-5" })
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            App.init();
            TableManageResponsive.init();
        });
    </script>
}
