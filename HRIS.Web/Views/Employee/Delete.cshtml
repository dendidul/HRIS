@model HRIS.General.Model.PersonalAdmin.EmployeeAttributeViewModel

@{
    ViewData["Title"] = "Delete Employee";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var fullName = $"{Model.People?.first_name} {Model.People?.middle_name} {Model.People?.last_name}".Trim();
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card mb-4 border-danger">
            <div class="card-header bg-label-danger">
                <h5 class="card-title text-danger mb-0">
                    <i class="bx bx-error-circle me-1"></i> Confirm Delete Employee
                </h5>
            </div>
            <div class="card-body pt-4">
                <p class="lead">Are you sure you want to delete this employee record?</p>
                <div class="alert alert-warning">
                    <strong>Warning:</strong> Deleting will remove personal records and soft-delete the employment attributes for <strong>@fullName (NIK: @(Model.EmployeeAttributes?.nik ?? "-"))</strong>.
                </div>

                <dl class="row mt-4">
                    <dt class="col-sm-4">Employee NIK</dt>
                    <dd class="col-sm-8">@(Model.EmployeeAttributes?.nik ?? "-")</dd>

                    <dt class="col-sm-4">Full Name</dt>
                    <dd class="col-sm-8">@fullName</dd>

                    <dt class="col-sm-4">Unit / Department</dt>
                    <dd class="col-sm-8">@(Model.EmployeeAttributes?.unit_desc ?? "-")</dd>

                    <dt class="col-sm-4">Position</dt>
                    <dd class="col-sm-8">@(Model.EmployeeAttributes?.position_desc ?? "-")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">@(Model.EmployeeAttributes?.status_employee ?? "-")</dd>

                    <dt class="col-sm-4">Hire Date</dt>
                    <dd class="col-sm-8">@(Model.EmployeeAttributes?.hire_date?.ToString("dd-MM-yyyy") ?? "-")</dd>
                </dl>
            </div>
            <div class="card-footer d-flex justify-content-between border-top">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bx bx-arrow-back me-1"></i> Cancel
                </a>
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.People.id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bx bx-trash me-1"></i> Delete Employee
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
