@model HRIS.General.Model.TimeManagement.TimeCalculationModel

@{
    ViewData["Title"] = "Create Time Calculation";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var areas = ViewBag.Areas as IEnumerable<HRIS.General.Model.Payroll.PayAreaModel> ?? new List<HRIS.General.Model.Payroll.PayAreaModel>();
    var processes = ViewBag.Processes as IEnumerable<HRIS.General.Model.Payroll.PayProcModel> ?? new List<HRIS.General.Model.Payroll.PayProcModel>();
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Create Time Calculation Batch</h5>
        <small class="text-muted">Time Management</small>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="payroll_area_id">Payroll Area <span class="text-danger">*</span></label>
                    <select name="payroll_area_id" id="payroll_area_id" class="select2 form-select" data-placeholder="-- Select Payroll Area (Type to search) --" data-allow-clear="true" required>
                        <option value=""></option>
                        @foreach (var a in areas)
                        {
                            <option value="@a.id">@a.payroll_area_id - @a.short_desc</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="payroll_process_id">Payroll Process <span class="text-danger">*</span></label>
                    <select name="payroll_process_id" id="payroll_process_id" class="select2 form-select" data-placeholder="-- Select Payroll Process (Type to search) --" data-allow-clear="true" required>
                        <option value=""></option>
                        @foreach (var p in processes)
                        {
                            <option value="@p.id">@p.payroll_process_id - @p.short_desc</option>
                        }
                    </select>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="sequence">Sequence Number <span class="text-danger">*</span></label>
                    <select name="sequence" id="sequence" class="select2 form-select" data-placeholder="-- Select Sequence --">
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i" selected="@(i == 1 ? "selected" : null)">Sequence @i</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="year">Year Period <span class="text-danger">*</span></label>
                    <select name="year" id="year" class="select2 form-select" data-placeholder="-- Select Year --">
                        @for (int y = DateTime.Now.Year - 3; y <= DateTime.Now.Year + 1; y++)
                        {
                            <option value="@y" selected="@(y == DateTime.Now.Year ? "selected" : null)">@y</option>
                        }
                    </select>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="form-label" for="begin_date">Begin Date <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(model => model.begin_date, "{0:yyyy-MM-dd}", new { Class = "form-control", id = "begin_date", type = "date", required = "true" })
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="end_date">End Date <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(model => model.end_date, "{0:yyyy-MM-dd}", new { Class = "form-control", id = "end_date", type = "date", required = "true" })
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bx bx-play-circle me-1"></i> Create Batch
                </button>
                <a href="@Url.Action("Index", "TimeCalculation")" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $('.select2').select2({
                placeholder: function () {
                    return $(this).data('placeholder') || '-- Select --';
                },
                allowClear: true,
                width: '100%'
            });
        });
    </script>
}

