@model HRIS.General.Model.UserManagement.UserModel


@{
    ViewData["Title"] = "Create Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Create", "Users", FormMethod.Post, new { Id = "formCreateArea" }))
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            
            <h4 class="card-title mb-0">Create</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-6">
                    <label>Users</label>
                    @Html.TextBoxFor(model => model.username, new { Class = "form-control", required = "true" })
                </div>
                <div class="col-6">
                    <label>Password</label>
                    @Html.TextBoxFor(model => model.password, new { Class = "form-control", required = "true" })
                </div>
                <div class="col-6">
                    <label>Role </label>
                    @*@Html.TextBoxFor(model => model.role_id, new { Class = "form-control", required = "true" })*@
                    @Html.DropDownListFor(model => model.role_id, ViewBag.ListRole as IEnumerable<SelectListItem>, "Please Select Role", new { Class = "form-control", Placeholder = "", required = "true" })
                </div>
                <div class="col-6">
                    <label>Employee </label>
                    @Html.TextBoxFor(model => model.employeeid, new { Class = "form-control", required = "true" })
                </div>
               
            </div>

            <br />
            <div class="row">
                <div class="col-6">
                    <button type="submit" class="btn btn-success">Save</button>
                    <a href="@Url.Action("Index","Users")" class="btn btn-warning">Cancel</a>
                </div>
            </div>





        </div>
    </div>
}



@section scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            App.init();
        });
    </script>
}



