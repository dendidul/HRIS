@model IEnumerable<HRIS.General.Model.UserManagement.UserModel>

@{
    ViewData["Title"] = "List User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        
        <h4 class="card-title mb-0">Users</h4>
    
        <a class="btn btn-primary" asp-action="Create">
            <i class="bx bx-plus me-1"></i> Create New
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive text-nowrap">
        <table class="table table-hover table-striped" id="data-table-responsive" style="width:100%">
            <thead>
                <tr>

                    <th>
                        UserName
                    </th>
                    <th>
                        Employee Id
                    </th>
                    <th>
                        Employee Name
                    </th>

                    <th class="text-center" style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                <tr>

                    <td>
                        @Html.DisplayFor(modelItem => item.username)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.employeeid)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.employeename)
                    </td>


                    <td>
                        @Html.ActionLink("Edit", "Edit", "Users", new { id = item.id }, new { @class = "btn btn-sm btn-outline-primary me-1" })
                        @Html.ActionLink("Details", "Details", "Users", new { id = item.id }, new { @class = "btn btn-sm btn-outline-info me-1" })
                        @Html.ActionLink("Delete", "Delete", new { id = item.id }, new { @class = "btn btn-sm btn-outline-danger" })

                    </td>
                </tr>
                }
            }
            </tbody>
        </table>
        </div>
    </div>
</div>

@section scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            App.init();
            TableManageResponsive.init();
        });
    </script>
}
