@model IEnumerable<HRIS.General.Model.UserManagement.UserModel>

@{
    ViewData["Title"] = "List User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        
        <h4 class="card-title mb-0">Users</h4>
    </div>
    <div class="card-body">
        <p>
            <a class="btn btn-primary" asp-action="Create">Create New</a>
        </p>
        <table class="table table-striped table-bordered" id="data-table-responsive" style="width:100%">
            <thead>
                <tr>

                    <th>
                        UserName
                    </th>
                    <th>
                        Employee Id
                    </th>
                    <th>
                        Employee Name
                    </th>

                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                <tr>

                    <td>
                        @Html.DisplayFor(modelItem => item.username)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.employeeid)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.employeename)
                    </td>


                    <td>
                        @Html.ActionLink("Edit", "Edit", "Users", new { id = item.id }, new { @class = "btn btn-success m-b-5" })
                        @Html.ActionLink("Details", "Details", "Users", new { id = item.id }, new { @class = "btn btn-warning m-b-5" })
                        @Html.ActionLink("Delete", "Delete", new { id = item.id }, new { @class = "btn btn-danger m-b-5" })

                    </td>
                </tr>
                }
            }
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            App.init();
            TableManageResponsive.init();
        });
    </script>
}
