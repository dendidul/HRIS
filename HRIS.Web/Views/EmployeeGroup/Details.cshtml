@model HRIS.General.Model.Master.EmployeeGroupModel
@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        
        <h4 class="card-title mb-0">Details</h4>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-6">
                <label>Group Code</label>
                @Html.HiddenFor(model => model.id, new { Class = "form-control" })
                @Html.TextBoxFor(model => model.Group_code, new { Class = "form-control", disabled = "true" })
            </div>
            <div class="col-6">
                <div class="form-group">
                    <label>Short Desc</label>
                    @Html.TextBoxFor(model => model.short_desc, new { Class = "form-control", disabled = "true" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-6">
                <label>Long Desc</label>
                @Html.TextAreaFor(model => model.long_desc, new { Class = "form-control", disabled = "true" })
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-6">
                @*<button type="submit" class="btn btn-success">Save</button>*@
                <a href="@Url.Action("Index","EmployeeGroup")" class="btn btn-warning">Back To List</a>
            </div>
        </div>

    </div>
</div>





@section scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            App.init();
        });
    </script>
}


