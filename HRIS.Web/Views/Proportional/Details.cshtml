@model HRIS.General.Model.Payroll.PayProportionalModel

@{
    ViewData["Title"] = "Proportional Rule Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Proportional Rule Details</h5>
        <small class="text-muted float-end">Payroll Management</small>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Rule Code</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.proportional_id)</dd>

            <dt class="col-sm-3">Short Description</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.short_desc)</dd>

            <dt class="col-sm-3">Long Description</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.long_desc)</dd>

            <dt class="col-sm-3">Numerator Type</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.numerator_type)</dd>

            <dt class="col-sm-3">Numerator Amount</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.numerator_amount)</dd>

            <dt class="col-sm-3">Denominator Type</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.denominator_type)</dd>

            <dt class="col-sm-3">Denominator Amount</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.denominator_amount)</dd>
        </dl>

        <div class="mt-4 d-flex gap-2">
            <a href="@Url.Action("Edit", "Proportional", new { id = Model.id })" class="btn btn-primary">
                <i class="bx bx-edit me-1"></i> Edit
            </a>
            <a href="@Url.Action("Index", "Proportional")" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>
</div>
