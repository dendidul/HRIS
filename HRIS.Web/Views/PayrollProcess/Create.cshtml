@model HRIS.General.Model.Payroll.PayProcModel

@{
    ViewData["Title"] = "Create Payroll Process";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var periods = ViewBag.Periods as IEnumerable<HRIS.General.Model.Payroll.PayPeriodModel> ?? new List<HRIS.General.Model.Payroll.PayPeriodModel>();
}

@using (Html.BeginForm("Create", "PayrollProcess", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Create Payroll Process</h5>
            <small class="text-muted float-end">Payroll Management</small>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label" for="payroll_process_id">Process Code</label>
                    @Html.TextBoxFor(model => model.payroll_process_id, new { Class = "form-control", id = "payroll_process_id", required = "true", placeholder = "e.g. PROC01" })
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="short_desc">Short Description</label>
                    @Html.TextBoxFor(model => model.short_desc, new { Class = "form-control", id = "short_desc", required = "true" })
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="payroll_periode_id">Payroll Period</label>
                    <select name="payroll_periode_id" class="form-select">
                        <option value="">-- Select Period --</option>
                        @foreach (var p in periods)
                        {
                            <option value="@p.id">@p.payroll_periode_id - @p.short_desc</option>
                        }
                    </select>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label" for="calculation_function">Calculation Function</label>
                    @Html.TextBoxFor(model => model.calculation_function, new { Class = "form-control", id = "calculation_function", placeholder = "Regular" })
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="working_period">Working Period (Days)</label>
                    @Html.TextBoxFor(model => model.working_period, new { Class = "form-control", id = "working_period", placeholder = "25" })
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="employee_status">Employee Status</label>
                    <select name="employee_status" class="form-select">
                        <option value="ALL">All Employees</option>
                        <option value="PERMANENT">Permanent Only</option>
                        <option value="CONTRACT">Contract Only</option>
                    </select>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="form-label" for="begin_date">Begin Date</label>
                    @Html.TextBoxFor(model => model.begin_date, "{0:yyyy-MM-dd}", new { Class = "form-control", id = "begin_date", type = "date" })
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="end_date">End Date</label>
                    @Html.TextBoxFor(model => model.end_date, "{0:yyyy-MM-dd}", new { Class = "form-control", id = "end_date", type = "date" })
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bx bx-save me-1"></i> Save
                </button>
                <a href="@Url.Action("Index", "PayrollProcess")" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </div>
}
