@model HRIS.General.Model.Payroll.PayProcModel

@{
    ViewData["Title"] = "Payroll Process Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Payroll Process Details</h5>
        <small class="text-muted float-end">Payroll Management</small>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Process Code</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.payroll_process_id)</dd>

            <dt class="col-sm-3">Short Description</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.short_desc)</dd>

            <dt class="col-sm-3">Period ID</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.payroll_periode_id)</dd>

            <dt class="col-sm-3">Calculation Function</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.calculation_function)</dd>

            <dt class="col-sm-3">Working Period</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.working_period) Days</dd>

            <dt class="col-sm-3">Employee Status</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.employee_status)</dd>

            <dt class="col-sm-3">Begin Date</dt>
            <dd class="col-sm-9">@(Model.begin_date?.ToString("dd MMM yyyy") ?? "-")</dd>

            <dt class="col-sm-3">End Date</dt>
            <dd class="col-sm-9">@(Model.end_date?.ToString("dd MMM yyyy") ?? "-")</dd>
        </dl>

        <div class="mt-4 d-flex gap-2">
            <a href="@Url.Action("Edit", "PayrollProcess", new { id = Model.id })" class="btn btn-primary">
                <i class="bx bx-edit me-1"></i> Edit
            </a>
            <a href="@Url.Action("Index", "PayrollProcess")" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>
</div>
