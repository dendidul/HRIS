@model IEnumerable<HRIS.General.Model.TimeManagement.CompanyCalendarModel>

@{
    ViewData["Title"] = "List Company Calendar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        
        <h4 class="card-title mb-0">Company Calendar</h4>
    </div>
    <div class="card-body">
        <p>
            <a class="btn btn-primary" asp-action="Create">Create New</a>
        </p>
        <table class="table table-striped table-bordered" id="data-table-responsive" style="width:100%">
            <thead>
                <tr>

                    <th>
                        Area
                    </th>
                    <th>
                        Work Group
                    </th>
                    <th>
                        Attendance Type
                    </th>
                    <th>
                        Begin Date
                    </th>
                    <th>
                       End Date
                    </th>




                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                <tr>

                    <td>
                        @Html.DisplayFor(modelItem => item.area_code)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.workgroup_code)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.attendance_code)
                    </td>
                    <td>
                        @*@Html.DisplayFor(modelItem => item.begin_date)*@
                        @{ 
                            if(item.begin_date.HasValue)
                            {
                                <label> @item.begin_date.Value.ToString("dd-MM-yyyy")</label>
                            }
                        }
                    </td>
                    <td>
                        @{
                            if (item.end_date.HasValue)
                            {
                                <label> @item.end_date.Value.ToString("dd-MM-yyyy")</label>
                            }
                        }
                    </td>

                    <td>
                        @Html.ActionLink("Edit", "Edit", "CompanyCalendar", new { id = item.id }, new { @class = "btn btn-success m-b-5" })
                        @Html.ActionLink("Details", "Details", "CompanyCalendar", new { id = item.id }, new { @class = "btn btn-warning m-b-5" })
                        @Html.ActionLink("Delete", "Delete", new { id = item.id }, new { @class = "btn btn-danger m-b-5" })

                    </td>
                </tr>
                }
            }
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            App.init();
            TableManageResponsive.init();
        });
    </script>
}
