@model HRIS.General.Model.TimeManagement.WorkGroupModel


@{
    ViewData["Title"] = "Create WorkGroup";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Create", "Workgroup", FormMethod.Post, new { Id = "formCreateTimeFrame" }))
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            
            <h4 class="card-title mb-0">Create</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-6">
                    <label>Workgroup Code</label>
                    @Html.TextBoxFor(model => model.workgroup_id, new { Class = "form-control", required = "true" })
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label>Short Desc</label>
                        @Html.TextBoxFor(model => model.short_desc, new { Class = "form-control", required = "true" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-6">
                    <label>Long Desc</label>
                    @Html.TextAreaFor(model => model.long_desc, new { Class = "form-control" })
                </div>
            </div>
            <div class="row">
                <div class="col-6">
                    <label>Schedule Variant Id</label>
                    @Html.TextBoxFor(model => model.schedule_variant_id, new { Class = "form-control", required = "true" })
                </div>
            </div>
            <div class="row">
                <div class="col-6">
                    <label>Schedule Sequence</label>
                    @Html.TextBoxFor(model => model.schedule_seq, new { Class = "form-control", required = "true" })
                </div>
            </div>
            @*<div class="row">
                <div class="col-6">
                    <label>Duration Time</label>
                    @Html.TextBoxFor(model => model.duration_time, new { Class = "form-control", required = "true" })
                </div>
            </div>*@
            <br />
            <div class="row">
                <div class="col-6">
                    <button type="submit" class="btn btn-success">Save</button>
                    <a href="@Url.Action("Index","Workgroup")" class="btn btn-warning">Cancel</a>
                </div>
            </div>





        </div>
    </div>
}



@section scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            App.init();
        });
    </script>
}



