@model IEnumerable<HRIS.General.Model.TimeManagement.WorkGroupModel>

@{
    ViewData["Title"] = "List Workgroup";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        
        <h4 class="card-title mb-0">Workgroup</h4>
    </div>
    <div class="card-body">
        <p>
            <a class="btn btn-primary" asp-action="Create">Create New</a>
        </p>
        <table class="table table-striped table-bordered" id="data-table-responsive" style="width:100%">
            <thead>
                <tr>

                    <th>
                        Workgroup Code
                    </th>
                    <th>
                        Short Desc
                    </th>
                    <th>
                        Long Desc
                    </th>




                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @Html.DisplayFor(modelItem => item.workgroup_id)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.short_desc)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.long_desc)
                        </td>

                        <td>
                            @Html.ActionLink("Edit", "Edit", "Workgroup", new { id = item.id }, new { @class = "btn btn-success m-b-5" })
                            @Html.ActionLink("Details", "Details", "Workgroup", new { id = item.id }, new { @class = "btn btn-warning m-b-5" })
                            @Html.ActionLink("Delete", "Delete", new { id = item.id }, new { @class = "btn btn-danger m-b-5" })

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            App.init();
            TableManageResponsive.init();
        });
    </script>
}
