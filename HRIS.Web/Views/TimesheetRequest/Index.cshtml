@model IEnumerable<HRIS.General.Model.TimeManagement.TimesheetReqModel>

@{
    ViewData["Title"] = "List Timesheet Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        
        <h4 class="card-title mb-0">Timesheet Request</h4>
    
        <a class="btn btn-primary" asp-action="Create">
            <i class="bx bx-plus me-1"></i> Create New
        </a>
    </div>
    <div class="card-body">
        <table class="table table-striped table-bordered" id="data-table-responsive" style="width:100%">
            <thead>
                <tr>

                    <th>
                        Employee ID
                    </th>
                    <th>
                        Employee Name
                    </th>
                    <th>
                       Request Date
                    </th>
                    <th>
                        Time In
                    </th>
                    <th>
                        Time Out
                    </th>
                    <th>
                        Request Status
                    </th>




                    <th class="text-center" style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                <tr>

                    <td>
                        @Html.DisplayFor(modelItem => item.NIK)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.EmployeeName)
                    </td>
                    <td>
                        @{
                            if (item.transaction_date.HasValue)
                            {
                                <label> @item.transaction_date.Value.ToString("dd-MM-yyyy")</label>
                            }
                        }
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.time_in)

                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.time_out)

                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.request_status)

                    </td>

                    <td>
                        @Html.ActionLink("Edit", "Edit", "TimesheetRequest", new { id = item.id }, new { @class = "btn btn-sm btn-outline-primary me-1" })
                        @Html.ActionLink("Details", "Details", "TimesheetRequest", new { id = item.id }, new { @class = "btn btn-sm btn-outline-info me-1" })
                        @Html.ActionLink("Delete", "Delete", new { id = item.id }, new { @class = "btn btn-sm btn-outline-danger" })

                    </td>
                </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@section scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            App.init();
            TableManageResponsive.init();
        });
    </script>
}
