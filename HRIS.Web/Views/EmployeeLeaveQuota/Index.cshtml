@model IEnumerable<HRIS.General.Model.PersonalAdmin.EmployeeQuotaModel>

@{
    ViewData["Title"] = "List Employee Leave Quota";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        
        <h4 class="card-title mb-0">Employee Leave Quota</h4>
    
        <a class="btn btn-primary" asp-action="Create">
            <i class="bx bx-plus me-1"></i> Create New
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive text-nowrap">
        <table class="table table-hover table-striped" id="data-table-responsive" style="width:100%">
            <thead>
                <tr>

                    <th>
                        Employee ID
                    </th>
                    <th>
                        Employee Name
                    </th>
                    <th>
                        Un-Attendance Type
                    </th>
                    <th>
                        Quota
                    </th>
                   




                    <th class="text-center" style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @item.EmployeeId

                        </td>
                        <td>
                           @item.EmployeeName


                        </td>
                        <td>
                            @item.UnattendanceCode

                        </td>
                        <td>
                            @item.quota

                        </td>
                       

                        <td>
                            @Html.ActionLink("Edit", "Edit", "EmployeeLeaveQuota", new { id = item.id }, new { @class = "btn btn-sm btn-outline-primary me-1" })
                            @Html.ActionLink("Details", "Details", "EmployeeLeaveQuota", new { id = item.id }, new { @class = "btn btn-sm btn-outline-info me-1" })
                            @Html.ActionLink("Delete", "Delete", new { id = item.id }, new { @class = "btn btn-sm btn-outline-danger" })

                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
        </div>
    </div>
</div>

@section scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            App.init();
            TableManageResponsive.init();
        });
    </script>
}
