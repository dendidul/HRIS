@model IEnumerable<HRIS.General.Model.UserManagement.MenuModel>

@{
    ViewData["Title"] = "Menu Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="card-title mb-0">Menu Management</h4>
        <a class="btn btn-primary" asp-action="Create">
            <i class="bx bx-plus me-1"></i> Create New
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive text-nowrap">
            <table class="table table-striped table-bordered" id="data-table-responsive" style="width:100%">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Menu Name</th>
                        <th>Link / URL</th>
                        <th>Controller</th>
                        <th>Parent ID</th>
                        <th>Sequence</th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>#@item.id</strong></td>
                                <td>@item.menu_name</td>
                                <td><code>@item.link</code></td>
                                <td>@(item.controller_name ?? "-")</td>
                                <td>@item.parent_id</td>
                                <td>@item.index</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.id" class="btn btn-sm btn-outline-primary">
                                        <i class="bx bx-edit-alt me-1"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.id" class="btn btn-sm btn-outline-danger">
                                        <i class="bx bx-trash me-1"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            if (typeof TableManageResponsive !== 'undefined') {
                TableManageResponsive.init();
            }
        });
    </script>
}
