
@{
    ViewData["Title"] = "Overtime Timesheet";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    <i class="bx bx-calendar-check me-2"></i> Overtime Timesheet Filter
                </h5>
            </div>
            <div class="card-body">
                <form id="formOvertimeTimesheet">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="txtFrom">Period From <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="txtFrom" value="@DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="txtTo">Period To <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="txtTo" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="ddlArea">Area</label>
                            <select id="ddlArea" asp-items="ViewBag.AreaList" class="form-select select2" data-placeholder="-- All Areas --">
                                <option value="">-- All Areas --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="ddlWorkgroup">Workgroup / Shift</label>
                            <select id="ddlWorkgroup" asp-items="ViewBag.WorkgroupList" class="form-select select2" data-placeholder="-- All Workgroups --">
                                <option value="">-- All Workgroups --</option>
                            </select>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label" for="ddlEmployee">Employee</label>
                            <select id="ddlEmployee" asp-items="ViewBag.EmployeeList" class="form-select select2" data-placeholder="-- All Employees --">
                                <option value="">-- All Employees --</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-search me-1"></i> Search Timesheet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            if ($.fn.select2) {
                $('.select2').select2({
                    width: '100%',
                    placeholder: function () {
                        return $(this).data('placeholder') || '-- Select --';
                    },
                    allowClear: true
                });
            }
        });
    </script>
}

