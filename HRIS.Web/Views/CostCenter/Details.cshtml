@model HRIS.General.Model.Master.CostCenterModel

@{
    ViewData["Title"] = "Cost Center Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Cost Center Details</h5>
        <small class="text-muted float-end">Master Data</small>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Cost Center Code</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.cost_center_code)</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.description)</dd>

            <dt class="col-sm-3">Begin Date</dt>
            <dd class="col-sm-9">@(Model.begin_date?.ToString("dd MMM yyyy") ?? "-")</dd>

            <dt class="col-sm-3">End Date</dt>
            <dd class="col-sm-9">@(Model.end_date?.ToString("dd MMM yyyy") ?? "-")</dd>
        </dl>

        <div class="mt-4 d-flex gap-2">
            <a href="@Url.Action("Edit", "CostCenter", new { id = Model.id })" class="btn btn-primary">
                <i class="bx bx-edit me-1"></i> Edit
            </a>
            <a href="@Url.Action("Index", "CostCenter")" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>
</div>
