@model IEnumerable<HRIS.General.Model.TimeManagement.UnattendanceModel>

@{
    ViewData["Title"] = "List Attendance Config";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        
        <h4 class="card-title mb-0">Attendance Config</h4>
    
        <a class="btn btn-primary" asp-action="Create">
            <i class="bx bx-plus me-1"></i> Create New
        </a>
    </div>
    <div class="card-body">
        <table class="table table-striped table-bordered" id="data-table-responsive" style="width:100%">
            <thead>
                <tr>

                    <th>
                        Attendance Code
                    </th>
                    <th>
                        Short Desc
                    </th>
                    <th>
                        Long Desc
                    </th>




                    <th class="text-center" style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @Html.DisplayFor(modelItem => item.unattendance_id)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.short_desc)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.long_desc)
                        </td>

                        <td>
                            @Html.ActionLink("Edit", "Edit", "AttendanceConfig", new { id = item.id }, new { @class = "btn btn-sm btn-outline-primary me-1" })
                            @Html.ActionLink("Details", "Details", "AttendanceConfig", new { id = item.id }, new { @class = "btn btn-sm btn-outline-info me-1" })
                            @Html.ActionLink("Delete", "Delete", new { id = item.id }, new { @class = "btn btn-sm btn-outline-danger" })

                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@section scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            App.init();
            TableManageResponsive.init();
        });
    </script>
}
