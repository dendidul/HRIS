@{
    Layout = null;

    var Title = ViewData["Title"];
    if (Title == null)
    {
        Title = "HRIS";
    }
}

@inject CookieManager.ICookie _httpCookie

<!DOCTYPE html>
<html lang="en"
      class="light-style layout-menu-fixed layout-compact"
      dir="ltr"
      data-theme="theme-default"
      data-assets-path="~/sneat/"
      data-template="vertical-menu-template-free">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>HRIS | @Title</title>
    <meta name="description" content="Human Resource Information System" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/sneat/img/favicon/favicon.ico" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet" />

    <!-- Icons -->
    <link rel="stylesheet" href="~/sneat/vendor/fonts/boxicons.css" />
    <link rel="stylesheet" href="~/assets/plugins/font-awesome/css/all.min.css" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="~/sneat/vendor/css/core.css" class="template-customizer-core-css" />
    <link rel="stylesheet" href="~/sneat/vendor/css/theme-default.css" class="template-customizer-theme-css" />
    <link rel="stylesheet" href="~/sneat/css/demo.css" />

    <!-- Vendors CSS -->
    <link rel="stylesheet" href="~/sneat/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="~/sneat/vendor/libs/apex-charts/apex-charts.css" />
    <link rel="stylesheet" href="~/assets/plugins/DataTables/media/css/dataTables.bootstrap4.min.css" />
    <link rel="stylesheet" href="~/assets/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap4.min.css" />
    <link rel="stylesheet" href="~/assets/plugins/gritter/css/jquery.gritter.css" />
    <link rel="stylesheet" href="~/assets/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.css" />
    <link rel="stylesheet" href="~/assets/plugins/bootstrap-eonasdan-datetimepicker/build/css/bootstrap-datetimepicker.min.css" />
    <link rel="stylesheet" href="~/assets/selectpicker/bootstrap-select.min.css" />
    <link rel="stylesheet" href="~/sneat/vendor/libs/select2/select2.css" />

    <!-- Helpers -->
    <script src="~/sneat/vendor/js/helpers.js"></script>
    <script src="~/sneat/js/config.js"></script>

    <style>
        /* Legacy panel compatibility bridge to Sneat card */
        .panel {
            border: none;
            box-shadow: 0 2px 6px 0 rgba(67, 89, 113, 0.12);
            border-radius: 0.5rem;
            background: #fff;
            margin-bottom: 1.5rem;
        }
        .panel-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid #d9dee3;
            background: transparent;
        }
        .panel-title {
            font-size: 1.125rem;
            font-weight: 500;
            color: #566a7f;
            margin: 0;
        }
        .panel-heading-btn {
            display: none; /* Hide old panel buttons */
        }
        .panel-body {
            padding: 1.5rem;
        }
        .loadingSign {
            height: 100%;
            width: 100%;
            position: fixed;
            background: rgba(255,255,255,0.8);
            top: 0;
            left: 0;
            z-index: 9999;
        }
        .loadingSign img {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 50px;
        }

        /* Sneat Bootstrap 5 DataTables styling bridge */
        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter {
            margin-bottom: 1rem;
        }
        .dataTables_wrapper .dataTables_length select {
            border: 1px solid #d9dee3;
            border-radius: 0.375rem;
            padding: 0.35rem 1.8rem 0.35rem 0.75rem;
            margin: 0 0.5rem;
            color: #697a8d;
        }
        .dataTables_wrapper .dataTables_filter input {
            border: 1px solid #d9dee3;
            border-radius: 0.375rem;
            padding: 0.35rem 0.75rem;
            margin-left: 0.5rem;
            color: #697a8d;
        }
        .dataTables_wrapper .dataTables_info {
            padding-top: 0.85rem;
            color: #a1acb8;
            font-size: 0.85rem;
        }
        .dataTables_wrapper .dataTables_paginate {
            margin-top: 0.75rem;
            text-align: right;
        }
        .dataTables_wrapper .dataTables_paginate ul.pagination {
            display: inline-flex;
            list-style: none;
            padding: 0;
            margin: 0;
            border-radius: 0.375rem;
        }
        .dataTables_wrapper .dataTables_paginate .page-item {
            margin: 0 2px;
        }
        .dataTables_wrapper .dataTables_paginate .page-item .page-link {
            border-radius: 0.375rem !important;
            padding: 0.45rem 0.85rem;
            font-size: 0.85rem;
            color: #697a8d;
            background-color: #f5f5f9;
            border: 1px solid #d9dee3;
            display: block;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s ease-in-out;
        }
        .dataTables_wrapper .dataTables_paginate .page-item:hover:not(.disabled):not(.active) .page-link {
            background-color: #e1e4e8;
            color: #566a7f;
            border-color: #d9dee3;
        }
        .dataTables_wrapper .dataTables_paginate .page-item.active .page-link {
            background-color: #696cff !important;
            border-color: #696cff !important;
            color: #fff !important;
            box-shadow: 0 2px 4px 0 rgba(105, 108, 255, 0.4);
        }
        .dataTables_wrapper .dataTables_paginate .page-item.disabled .page-link {
            color: #c7cdd4 !important;
            background-color: #fcfdfd !important;
            border-color: #e9ecef !important;
            cursor: not-allowed;
            pointer-events: none;
        }
        /* Fallback if rendered as plain paginate_button without Bootstrap ul.pagination */
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            display: inline-block;
            box-sizing: border-box;
            min-width: 1.8em;
            padding: 0.45rem 0.85rem;
            margin: 0 2px;
            text-align: center;
            text-decoration: none !important;
            cursor: pointer;
            color: #697a8d !important;
            border: 1px solid #d9dee3 !important;
            border-radius: 0.375rem !important;
            background: #f5f5f9 !important;
            font-size: 0.85rem;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background: #e1e4e8 !important;
            color: #566a7f !important;
            border-color: #d9dee3 !important;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button.current,
        .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
            color: #fff !important;
            border: 1px solid #696cff !important;
            background: #696cff !important;
            box-shadow: 0 2px 4px 0 rgba(105, 108, 255, 0.4);
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button.disabled,
        .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover {
            color: #c7cdd4 !important;
            border-color: #e9ecef !important;
            background: #fcfdfd !important;
            cursor: not-allowed !important;
        }
    </style>
</head>

<body>
    <!-- Layout wrapper -->
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <!-- Menu / Sidebar -->
            <aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
                <div class="app-brand demo">
                    <a href="@Url.Action("Dashboard", "Home")" class="app-brand-link">
                        <span class="app-brand-logo demo">
                            <i class="bx bx-buildings text-primary fs-3"></i>
                        </span>
                        <span class="app-brand-text demo menu-text fw-bold ms-2 text-capitalize">HRIS</span>
                    </a>

                    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto d-block d-xl-none">
                        <i class="bx bx-chevron-left bx-sm align-middle"></i>
                    </a>
                </div>

                <div class="menu-inner-shadow"></div>

                <!-- Dynamic Navigation Container -->
                <div id="menu">
                    <!-- Populated via AJAX call -->
                </div>
            </aside>
            <!-- / Menu -->

            <!-- Layout container -->
            <div class="layout-page">
                <!-- Navbar -->
                <nav class="layout-navbar container-xxl navbar navbar-expand-xl navbar-detached align-items-center bg-navbar-theme" id="layout-navbar">
                    <div class="layout-menu-toggle navbar-nav align-items-xl-center me-3 me-xl-0 d-xl-none">
                        <a class="nav-item nav-link px-0 me-xl-4" href="javascript:void(0)">
                            <i class="bx bx-menu bx-sm"></i>
                        </a>
                    </div>

                    <div class="navbar-nav-right d-flex align-items-center" id="navbar-collapse">
                        <!-- Search -->
                        <div class="navbar-nav align-items-center">
                            <div class="nav-item d-flex align-items-center">
                                <i class="bx bx-search fs-4 lh-0"></i>
                                <input type="text" class="form-control border-0 shadow-none ps-1 ps-sm-2" placeholder="Search..." aria-label="Search..." />
                            </div>
                        </div>
                        <!-- /Search -->

                        <ul class="navbar-nav flex-row align-items-center ms-auto">
                            <!-- User Dropdown -->
                            <li class="nav-item navbar-dropdown dropdown-user dropdown">
                                <a class="nav-link dropdown-toggle hide-arrow" href="javascript:void(0);" data-bs-toggle="dropdown">
                                    <div class="avatar avatar-online">
                                        <img src="~/sneat/img/avatars/1.png" alt class="w-px-40 h-auto rounded-circle" />
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <div class="d-flex">
                                                <div class="flex-shrink-0 me-3">
                                                    <div class="avatar avatar-online">
                                                        <img src="~/sneat/img/avatars/1.png" alt class="w-px-40 h-auto rounded-circle" />
                                                    </div>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <span class="fw-medium d-block">@_httpCookie.Get("UserName")</span>
                                                    <small class="text-muted">User</small>
                                                </div>
                                            </div>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("IndexEmployee", "Employee")">
                                            <i class="bx bx-user me-2"></i>
                                            <span class="align-middle">My Profile</span>
                                        </a>
                                    </li>
                                    <li>
                                        <div class="dropdown-divider"></div>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("LogOut", "Account")">
                                            <i class="bx bx-power-off me-2"></i>
                                            <span class="align-middle">Log Out</span>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <!--/ User Dropdown -->
                        </ul>
                    </div>
                </nav>
                <!-- / Navbar -->

                <!-- Content wrapper -->
                <div class="content-wrapper">
                    <!-- Content -->
                    <div class="container-xxl flex-grow-1 container-p-y" id="content">
                        @RenderBody()
                    </div>
                    <!-- / Content -->

                    <!-- Footer -->
                    <footer class="content-footer footer bg-footer-theme">
                        <div class="container-xxl d-flex flex-wrap justify-content-between py-2 flex-md-row flex-column">
                            <div class="mb-2 mb-md-0">
                                © @DateTime.Now.Year, HRIS - Human Resource Information System
                            </div>
                        </div>
                    </footer>
                    <!-- / Footer -->

                    <div class="content-backdrop fade"></div>
                </div>
                <!-- Content wrapper -->
            </div>
            <!-- / Layout page -->
        </div>

        <!-- Overlay -->
        <div class="layout-overlay layout-menu-toggle"></div>
    </div>
    <!-- / Layout wrapper -->

    <!-- Loading Indicator -->
    <div class="loadingSign" style="display: none">
        <img src="~/template/img/loadingpink.gif" alt="Loading..." />
    </div>

    <!-- Core JS -->
    <script src="~/sneat/vendor/libs/jquery/jquery.js"></script>
    <script src="~/sneat/vendor/libs/popper/popper.js"></script>
    <script src="~/sneat/vendor/js/bootstrap.js"></script>
    <script src="~/sneat/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/sneat/vendor/js/menu.js"></script>

    <!-- Vendors JS -->
    <script src="~/sneat/vendor/libs/apex-charts/apexcharts.js"></script>
    <script src="~/assets/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/assets/plugins/DataTables/media/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/assets/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/plugins/DataTables/extensions/Responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/assets/plugins/gritter/js/jquery.gritter.js"></script>
    <script src="~/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script src="~/assets/plugins/bootstrap-daterangepicker/moment.js"></script>
    <script src="~/assets/plugins/bootstrap-eonasdan-datetimepicker/build/js/bootstrap-datetimepicker.min.js"></script>
    <script src="~/assets/selectpicker/bootstrap-select.min.js"></script>
    <script src="~/sneat/vendor/libs/select2/select2.js"></script>

    <!-- Main JS -->
    <script src="~/sneat/js/main.js"></script>

    <!-- Compatibility wrapper for legacy code -->
    <script type="text/javascript">
        // Graceful dummy for old App.init() calls
        var App = {
            init: function () { }
        };

        // Automatic fallback initialization for data-table-responsive across all views
        $(document).ready(function () {
            if ($('#data-table-responsive').length !== 0 && !$.fn.DataTable.isDataTable('#data-table-responsive')) {
                $('#data-table-responsive').DataTable({
                    responsive: true,
                    pageLength: 10,
                    lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, "All"]],
                    columnDefs: [
                        { orderable: false, targets: -1 } // Disable sorting on the last column (Actions)
                    ],
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records...",
                        paginate: {
                            previous: '<i class="bx bx-chevron-left"></i>',
                            next: '<i class="bx bx-chevron-right"></i>',
                            first: '<i class="bx bx-chevrons-left"></i>',
                            last: '<i class="bx bx-chevrons-right"></i>'
                        }
                    }
                });
            }
        });
        var TableManageResponsive = {
            init: function () {
                if ($.fn.DataTable && $('#data-table-responsive').length > 0) {
                    if (!$.fn.DataTable.isDataTable('#data-table-responsive')) {
                        $('#data-table-responsive').DataTable({
                            responsive: true,
                            pageLength: 10,
                            lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, "All"]],
                            columnDefs: [
                                { orderable: false, targets: -1 } // Disable sorting on the last column (Actions)
                            ],
                            language: {
                                search: "_INPUT_",
                                searchPlaceholder: "Search records...",
                                paginate: {
                                    previous: '<i class="bx bx-chevron-left"></i>',
                                    next: '<i class="bx bx-chevron-right"></i>',
                                    first: '<i class="bx bx-chevrons-left"></i>',
                                    last: '<i class="bx bx-chevrons-right"></i>'
                                }
                            }
                        });
                    }
                }
            }
        };

        function ConvertStringToDate(str) {
            var rs = "";
            if (str != "") {
                var split = str.split('/');
                rs = split[1] + '/' + split[0] + '/' + split[2];
            }
            return rs;
        }

        $(document).ready(function () {
            // Submenu accordion toggle handler (handles both static and dynamic menu items)
            $(document).on('click', '#layout-menu .menu-toggle', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var $menuItem = $(this).closest('.menu-item');
                if ($menuItem.hasClass('open')) {
                    $menuItem.removeClass('open');
                } else {
                    if ($menuItem.parent().hasClass('menu-inner')) {
                        $menuItem.siblings('.menu-item.open').removeClass('open');
                    }
                    $menuItem.addClass('open');
                }
            });

            // Load dynamic menu
            var menuUrl = "@Url.Action("SetMenu", "GlobalAccessMenu")";
            $.ajax({
                url: menuUrl,
                cache: false,
                type: "POST",
                dataType: "html",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    $("#menu").html(data);

                    // Initialize Sneat Menu instance if available
                    var layoutMenuEl = document.getElementById('layout-menu');
                    if (layoutMenuEl && typeof Menu !== 'undefined' && !window.Helpers.mainMenu) {
                        try {
                            window.Helpers.mainMenu = new Menu(layoutMenuEl, {
                                orientation: 'vertical',
                                closeChildren: false
                            });
                        } catch (err) {
                            console.warn('Menu instance init notice:', err);
                        }
                    }
                    
                    // Highlight active menu item based on current URL path
                    var currentPath = window.location.pathname.toLowerCase();
                    $("#menu .menu-item a").each(function () {
                        var href = $(this).attr("href");
                        if (href && href !== "javascript:void(0);" && currentPath.indexOf(href.toLowerCase()) !== -1 && href !== "/") {
                            $(this).closest(".menu-item").addClass("active");
                            $(this).parents(".menu-item").addClass("open active");
                        }
                    });
                },
                error: function (jqXHR, textStatus, errorMessage) {
                    console.log("Error loading menu:", errorMessage);
                }
            });

            // Datepicker initialization
            if ($.fn.datepicker) {
                $('.datepicker').datepicker({
                    todayHighlight: true,
                    autoclose: true
                });
            }
            if ($.fn.datetimepicker) {
                $('.datetimepicker').datetimepicker({
                    format: 'DD-MM-YYYY HH:mm:ss'
                });
            }

            // Select2 searchable dropdown auto-initialization
            if ($.fn.select2) {
                $('.select2').each(function () {
                    var $this = $(this);
                    if (!$this.hasClass('select2-hidden-accessible')) {
                        $this.select2({
                            placeholder: $this.attr('placeholder') || $this.data('placeholder') || '-- Select --',
                            allowClear: Boolean($this.data('allow-clear')),
                            width: '100%'
                        });
                    }
                });
            }
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
