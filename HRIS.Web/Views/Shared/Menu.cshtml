@{
    List<HRIS.General.Model.ViewModel.RoleMenuViewModel> MenuLvl1 = ViewBag.Menu ?? new List<HRIS.General.Model.ViewModel.RoleMenuViewModel>();
    List<HRIS.General.Model.ViewModel.RoleMenuViewModel> MenuLvl2 = ViewBag.Menu ?? new List<HRIS.General.Model.ViewModel.RoleMenuViewModel>();
}

@functions {
    string ResolveMenuUrl(string rawUrl)
    {
        if (string.IsNullOrWhiteSpace(rawUrl) || rawUrl == "#")
            return "javascript:void(0);";
        
        var clean = rawUrl.Trim();
        if (clean.StartsWith("../../"))
        {
            clean = clean.Substring(5); // leaves "/Controller/Action/..."
        }
        else if (!clean.StartsWith("/"))
        {
            clean = "/" + clean;
        }
        return clean;
    }
}

<ul class="menu-inner py-1">
    <!-- Dashboard Link -->
    <li class="menu-item" id="menu-dashboard">
        <a href="@Url.Action("Dashboard", "Home")" class="menu-link">
            <i class="menu-icon tf-icons bx bx-home-circle"></i>
            <div data-i18n="Dashboard">Dashboard</div>
        </a>
    </li>

    @if (MenuLvl1 != null && MenuLvl1.Any())
    {
        @foreach (var mp in MenuLvl1.Where(p => p != null && p.ParentMenuId == 0 && p.Level == 1).OrderBy(p => p.Sequence))
        {
            var children = MenuLvl2.Where(model => model != null && model.ParentMenuId == mp.MenuId && model.Level == 2).ToList();
            var hasChild = children.Count > 0;
            var iconClass = string.IsNullOrEmpty(mp.icon) ? "bx bx-grid-alt" : mp.icon;
            
            if (iconClass.Contains("fa-") || iconClass.Contains("ion-"))
            {
                iconClass = "bx bx-layer";
            }

            <li class="menu-item">
                <a href="@(hasChild ? "javascript:void(0);" : ResolveMenuUrl(mp.Link))" 
                   class="menu-link @(hasChild ? "menu-toggle" : "")">
                    <i class="menu-icon tf-icons @iconClass"></i>
                    <div>@mp.MenuNm</div>
                </a>

                @if (hasChild)
                {
                    <ul class="menu-sub">
                        @foreach (var child in children.Where(c => c != null))
                        {
                            <li class="menu-item">
                                <a href="@ResolveMenuUrl(child.Link)" class="menu-link">
                                    <div>@child.MenuNm</div>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </li>
        }
    }
    else
