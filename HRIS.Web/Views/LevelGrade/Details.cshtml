@model HRIS.General.Model.Master.LevelGradeModel
@{
    ViewData["Title"] = "Delete Level Grade";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Delete", "LevelGrade", FormMethod.Post, new { Id = "formDeleteLevelGrade" }))
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            
            <h4 class="card-title mb-0">Delete</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-6">
                    <label>LevelGrade Code</label>
                    @Html.HiddenFor(model => model.id, new { Class = "form-control" })
                    @Html.TextBoxFor(model => model.level_id, new { Class = "form-control", disabled = "true" })
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label>Short Desc</label>
                        @Html.TextBoxFor(model => model.short_desc, new { Class = "form-control", disabled = "true" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-6">
                    <label>Long Desc</label>
                    @Html.TextAreaFor(model => model.long_desc, new { Class = "form-control", disabled = "true" })
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-6">
                    @*<button type="submit" class="btn btn-danger">Delete</button>*@
                    <a href="@Url.Action("Index","LevelGrade")" class="btn btn-warning">Back To List</a>
                </div>
            </div>

        </div>
    </div>

}




@section scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            App.init();
        });
    </script>
}


