@model HRIS.General.Model.TimeManagement.TimeFrameModel


@{
    ViewData["Title"] = "Edit Time Frame";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Edit", "TimeFrame", FormMethod.Post, new { Id = "formCreateTimeFrame" }))
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            
            <h4 class="card-title mb-0">Create</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-6">
                    <label>Time Frame Code</label>
                       @Html.HiddenFor(model => model.id)
                    @Html.TextBoxFor(model => model.time_frame_id, new { Class = "form-control", required = "true" })
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label>Short Desc</label>
                        @Html.TextBoxFor(model => model.short_desc, new { Class = "form-control", required = "true" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-6">
                    <label>Long Desc</label>
                    @Html.TextAreaFor(model => model.long_desc, new { Class = "form-control" })
                </div>
            </div>
            <div class="row">
                <div class="col-6">
                    <label>Start Time</label>
                    @Html.TextBoxFor(model => model.starting_time, new { Class = "form-control", required = "true" })
                </div>
            </div>
            <div class="row">
                <div class="col-6">
                    <label>Tolerance Time</label>
                    @Html.TextBoxFor(model => model.tolerance_time, new { Class = "form-control", required = "true" })
                </div>
            </div>
            <div class="row">
                <div class="col-6">
                    <label>Duration Time</label>
                    @Html.TextBoxFor(model => model.duration_time, new { Class = "form-control", required = "true" })
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-6">
                    <button type="submit" class="btn btn-success">Save</button>
                    <a href="@Url.Action("Index","TimeFrame")" class="btn btn-warning">Cancel</a>
                </div>
            </div>





        </div>
    </div>
}



@section scripts{

    <script type="text/javascript">
        $(document).ready(function () {
            App.init();
        });
    </script>
}



