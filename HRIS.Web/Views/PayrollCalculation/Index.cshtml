@model IEnumerable<HRIS.General.Model.Payroll.PayCalculationModel>

@{
    ViewData["Title"] = "Payroll Calculation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Payroll Calculation Batch</h5>
        <a class="btn btn-primary" asp-action="Create">
            <i class="bx bx-plus me-1"></i> New Calculation Batch
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive text-nowrap">
            <table class="table table-hover table-striped" id="data-table-responsive" style="width:100%">
                <thead>
                    <tr>
                        <th>Batch #</th>
                        <th>Year</th>
                        <th>Area</th>
                        <th>Period Dates</th>
                        <th>Status</th>
                        <th>Processed</th>
                        <th>Run Date</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                    @if (Model != null)
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>#@item.id</strong></td>
                                <td>@item.year_period</td>
                                <td>@item.payroll_area_id</td>
                                <td>
                                    @(item.begin_date?.ToString("dd/MM/yyyy") ?? "-") - @(item.end_date?.ToString("dd/MM/yyyy") ?? "-")
                                </td>
                                <td>
                                    @if (item.running_status == "Closed")
                                    {
                                        <span class="badge bg-label-success">Completed</span>
                                    }
                                    else if (item.running_status == "Open")
                                    {
                                        <span class="badge bg-label-warning">Open (Pending Run)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-label-danger">@item.running_status</span>
                                    }
                                </td>
                                <td>
                                    @(item.processed_employee ?? 0) Employees
                                </td>
                                <td>
                                    @(item.running_date?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                </td>
                                <td class="text-center">
                                    @if (item.running_status == "Open")
                                    {
                                        <form asp-action="RunCalculation" asp-route-id="@item.id" method="post" style="display:inline-block">
                                            <button type="submit" class="btn btn-sm btn-success me-1" onclick="return confirm('Execute payroll calculation for this batch?');">
                                                <i class="bx bx-play"></i> Run
                                            </button>
                                        </form>
                                    }
                                    <a class="btn btn-sm btn-outline-info me-1" asp-action="Details" asp-route-id="@item.id">Details</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.id">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            if (typeof TableManageResponsive !== 'undefined') {
                TableManageResponsive.init();
            }
        });
    </script>
}
