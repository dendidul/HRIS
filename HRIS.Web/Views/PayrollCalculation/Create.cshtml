@model HRIS.General.Model.Payroll.PayCalculationModel

@{
    ViewData["Title"] = "Create Payroll Calculation";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var areas = ViewBag.Areas as IEnumerable<HRIS.General.Model.Payroll.PayAreaModel> ?? new List<HRIS.General.Model.Payroll.PayAreaModel>();
    var processes = ViewBag.Processes as IEnumerable<HRIS.General.Model.Payroll.PayProcModel> ?? new List<HRIS.General.Model.Payroll.PayProcModel>();
    var periods = ViewBag.Periods as IEnumerable<HRIS.General.Model.Payroll.PayPeriodModel> ?? new List<HRIS.General.Model.Payroll.PayPeriodModel>();
}

@using (Html.BeginForm("Create", "PayrollCalculation", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Create Payroll Calculation Batch</h5>
            <small class="text-muted float-end">Payroll Management</small>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label" for="year_period">Year Period</label>
                    <input type="text" name="year_period" class="form-control" value="@DateTime.Now.Year" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="payroll_area_id">Payroll Area</label>
                    <select name="payroll_area_id" id="payroll_area_id" class="select2 form-select" data-placeholder="-- Select Area --" data-allow-clear="true" required>
                        <option value=""></option>
                        @foreach (var a in areas)
                        {
                            <option value="@a.id">@a.payroll_area_id - @a.short_desc</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="payroll_process_id">Payroll Process</label>
                    <select name="payroll_process_id" id="payroll_process_id" class="select2 form-select" data-placeholder="-- Select Process --" data-allow-clear="true" required>
                        <option value=""></option>
                        @foreach (var p in processes)
                        {
                            <option value="@p.id">@p.payroll_process_id - @p.short_desc</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="payroll_periode_id">Payroll Period</label>
                    <select name="payroll_periode_id" id="payroll_periode_id" class="select2 form-select" data-placeholder="-- Select Period --" data-allow-clear="true">
                        <option value=""></option>
                        @foreach (var per in periods)
                        {
                            <option value="@per.id">@per.payroll_periode_id - @per.short_desc</option>
                        }
                    </select>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="form-label" for="begin_date">Calculation Begin Date</label>
                    @Html.TextBoxFor(model => model.begin_date, "{0:yyyy-MM-dd}", new { Class = "form-control", id = "begin_date", type = "date", required = "true" })
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="end_date">Calculation End Date</label>
                    @Html.TextBoxFor(model => model.end_date, "{0:yyyy-MM-dd}", new { Class = "form-control", id = "end_date", type = "date", required = "true" })
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bx bx-save me-1"></i> Create Batch
                </button>
                <a href="@Url.Action("Index", "PayrollCalculation")" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </div>
}

@section scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $('.select2').select2({
                placeholder: function () {
                    return $(this).data('placeholder') || '-- Select --';
                },
                allowClear: true,
                width: '100%'
            });
        });
    </script>
}
